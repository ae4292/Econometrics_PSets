% econpset.sty -- shared style for problem-set write-ups.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{econpset}[2026/10/10 problem-set style]

\RequirePackage[a4paper,margin=1.15in]{geometry}
\RequirePackage[T1]{fontenc}
\RequirePackage[sc]{mathpazo}           % Palatino text + math
\RequirePackage{microtype}
\RequirePackage{amsmath,amssymb,mathtools}
\RequirePackage{xcolor}
\RequirePackage{enumitem}
\RequirePackage{titlesec}
\RequirePackage{fancyhdr}
\RequirePackage{tikz}
\RequirePackage[most]{tcolorbox}
\RequirePackage[colorlinks,allcolors=accent]{hyperref}

\definecolor{accent}{HTML}{1F4E79}

\linespread{1.05}
\setlength{\parindent}{0pt}
\setlength{\parskip}{0.55em}
\allowdisplaybreaks

% Notation
\newcommand{\E}{\mathbb{E}}
\newcommand{\Var}{\operatorname{Var}}
\newcommand{\Cov}{\operatorname{Cov}}
\newcommand{\todo}[1]{\textcolor{red}{[unclear in scan: #1]}}

% Headings: "Problem N" and "(a)" parts
\newcommand{\problem}[1]{%
  \par\vspace{1.4em}%
  {\large\bfseries\color{accent}Problem #1}\par\vspace{-0.6em}%
  {\color{accent}\rule{\linewidth}{0.6pt}}\par\vspace{0.3em}}
\newcommand{\subq}[1]{%
  \par\vspace{0.6em}\noindent{\bfseries #1}\quad\ignorespaces}

% Final answers: shaded block with an accent bar
\newcommand{\ans}[1]{%
  \begin{tcolorbox}[enhanced, breakable, boxrule=0pt, arc=0pt, frame hidden,
     colback=accent!6, borderline west={2.2pt}{0pt}{accent},
     left=9pt, right=6pt, top=3pt, bottom=3pt, before skip=8pt, after skip=8pt]
  #1
  \end{tcolorbox}}

% Title block
\newcommand{\psetheader}[3]{%
  \begin{center}
    {\Large\bfseries #1}\\[0.3em]
    {\large #2}\\[0.2em]
    {\small\color{black!60} #3}
  \end{center}\vspace{-0.4em}%
  {\color{accent}\rule{\linewidth}{1pt}}\vspace{0.2em}}

\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0pt}
\fancyfoot[C]{\small\thepage}
\endinput
